manifest {
    name            = 'siforge'
    description     = 'Multi-engine siRNA design with a calibrated Unified Silencing Score'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

params {
    outdir = 'results'
}

profiles {
    standard { process.executor = 'local' }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/../env/environment.yml"
    }

    docker {
        docker.enabled = true
        process.container = 'siforge:1.0.0'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }

    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'siforge-queue'
        process.container = 'siforge:1.0.0'
        aws.region        = 'us-east-1'
    }
}

process {
    cpus   = 2
    memory = '8 GB'
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries = 2
    withName: 'BUILD_SEEDTABLE' { memory = '16 GB' }
    withName: 'CALIBRATE'       { memory = '8 GB'  }
}

report  { enabled = true; file = "${params.outdir}/pipeline_report.html"; overwrite = true }
timeline{ enabled = true; file = "${params.outdir}/timeline.html";        overwrite = true }
trace   { enabled = true; file = "${params.outdir}/trace.txt";            overwrite = true }
